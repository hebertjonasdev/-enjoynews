---
import Badge from '../ui/Badge.astro';
import { format } from 'date-fns';
import { ptBR } from 'date-fns/locale';

interface Props {
  title: string;
  description: string;
  pubDate: string;
  heroImage?: string;
  heroImageAlt?: string;
  category?: string;
  tags?: string[];
  sourceName?: string;
  sourceUrl?: string;
  importance?: number;
  kicker?: string;
  slug: string;
  class?: string;
}

const { title, description, pubDate, heroImage, heroImageAlt, category, tags, sourceName, sourceUrl, importance, kicker, slug, class: className } = Astro.props;

const date = new Date(pubDate);
const formattedDate = format(date, "d 'de' MMMM", { locale: ptBR });
const timeAgo = format(date, "HH:mm", { locale: ptBR });

const importanceColors = {
  5: 'badge-orange',
  4: 'badge-orange',
  3: 'badge-brown',
  2: 'badge-brown',
  1: 'badge-gray',
};
---

<article class={classList({ 'card-interactive group': true, [className]: true })}>

  <!-- Hero Image -->
  {heroImage && (
    <a href={slug} class="relative block overflow-hidden" aria-label={`Leia: ${title}`}>
      <img
        src={heroImage}
        alt={heroImageAlt || title}
        class="w-full h-48 object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
      {importance && importance >= 4 && (
        <span class="absolute top-2 left-2 badge-orange text-xs font-semibold px-2 py-0.5">
          URGENTE
        </span>
      )}
      {kicker && (
        <span class="absolute bottom-2 left-2 bg-enjoy-paper/95 backdrop-blur-sm px-2 py-1 rounded text-xs font-medium text-enjoy-ink">
          {kicker}
        </span>
      )}
    </a>
  )}

  <!-- Content -->
  <div class="p-4 lg:p-5">
    <!-- Meta -->
    <div class="flex flex-wrap items-center gap-2 mb-2">
      {category && (
        <Badge variant="brown" size="sm">{category}</Badge>
      )}
      {tags && tags.slice(0, 2).map(tag => (
        <Badge variant="gray" size="sm" key={tag}>#{tag}</Badge>
      ))}
      {sourceName && (
        <span class="text-xs text-enjoy-inkMuted flex items-center gap-1">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-1.343 3-3s-1.343-3-3-3"/></svg>
          {sourceName}
        </span>
      )}
    </div>

    <!-- Title -->
    <h2 class="font-display text-enjoy-ink mb-2 leading-tight group-hover:text-enjoy-orange transition-colors">
      <a href={slug} class="hover:underline">
        {title}
      </a>
    </h2>

    <!-- Description -->
    <p class="text-enjoy-inkLight text-sm leading-relaxed line-clamp-3 mb-3">
      {description}
    </p>

    <!-- Footer -->
    <div class="flex items-center justify-between pt-3 border-t border-enjoy-line">
      <time class="text-xs text-enjoy-inkMuted" datetime={pubDate}>
        {formattedDate} às {timeAgo}
      </time>
      {sourceUrl && (
        <a href={sourceUrl} target="_blank" rel="noopener" class="text-xs text-enjoy-orange hover:underline flex items-center gap-1">
          Fonte original
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      )}
    </div>
  </div>
</article>