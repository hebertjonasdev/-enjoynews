---
import Badge from '../ui/Badge.astro';
import { format } from 'date-fns';
import { ptBR } from 'date-fns/locale';

interface Props {
  article: any;
}

const { article } = Astro.props;
const { title, description, pubDate, heroImage, heroImageAlt, category, tags, sourceName, sourceUrl, importance, kicker, slug } = article.data;

const date = new Date(pubDate);
const formattedDate = format(date, "EEEE, d 'de' MMMM 'de' yyyy", { locale: ptBR });
const timeAgo = format(date, "HH:mm", { locale: ptBR });
---

<article class="card overflow-hidden" aria-labelledby="hero-title">
  {heroImage && (
    <div class="relative h-64 lg:h-80 overflow-hidden">
      <img
        src={heroImage}
        alt={heroImageAlt || title}
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-enjoy-ink/60 via-transparent to-transparent" />
      <div class="absolute bottom-0 left-0 right-0 p-6">
        <div class="flex flex-wrap items-center gap-2 mb-2">
          {category && <Badge variant="orange" size="md">{category}</Badge>}
          {importance && importance >= 4 && (
            <Badge variant="orange" size="md" class="animate-pulse">URGENTE</Badge>
          )}
          {kicker && <Badge variant="brown" size="md">{kicker}</Badge>}
        </div>
      </div>
    </div>
  )}

  <div class="p-6 lg:p-8">
    <div class="flex flex-wrap items-center gap-2 mb-4">
      <time class="text-sm text-enjoy-inkMuted" datetime={pubDate}>
        {formattedDate} às {timeAgo}
      </time>
      {sourceName && (
        <span class="text-sm text-enjoy-inkMuted flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-1.343 3-3s-1.343-3-3-3"/></svg>
          {sourceName}
        </span>
      )}
    </div>

    <h1 id="hero-title" class="font-display text-enjoy-ink mb-4 leading-tight text-3xl lg:text-4xl">
      {title}
    </h1>

    <div class="prose-enjoy prose-enjoy-lg max-w-none text-enjoy-inkLight leading-relaxed">
      <p class="text-lg font-medium mb-6 text-enjoy-ink">{description}</p>
      <slot />
    </div>

    {sourceUrl && (
      <div class="mt-8 pt-6 border-t border-enjoy-line flex items-center justify-between">
        <a href={sourceUrl} target="_blank" rel="noopener" class="text-sm text-enjoy-orange hover:underline flex items-center gap-1 font-medium">
          Ler na fonte original
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
        <div class="flex gap-2">
          {tags && tags.slice(0, 5).map(tag => (
            <Badge variant="gray" size="sm" key={tag}>#{tag}</Badge>
          ))}
        </div>
      </div>
    )}
  </div>
</article>