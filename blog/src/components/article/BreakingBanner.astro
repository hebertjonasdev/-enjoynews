---
interface Props {
  articles: any[];
}

const { articles } = Astro.props;

// Filter breaking/urgent articles (importance >= 4)
const breaking = articles
  .filter(a => a.data.importance && a.data.importance >= 4)
  .slice(0, 5);

if (breaking.length === 0) {
  // Don't render anything if no breaking news
}
---

<div class="bg-enjoy-ink text-enjoy-paper py-2" role="region" aria-label="Notícias urgentes">
  <div class="container mx-auto px-4">
    <div class="flex items-center gap-4 overflow-x-auto scrollbar-hide pb-1">
      <span class="shrink-0 flex items-center gap-2 bg-enjoy-orange px-3 py-1 rounded-full">
        <svg class="w-4 h-4 animate-pulse" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
        <span class="font-semibold text-xs tracking-wide uppercase">URGENTE</span>
      </span>
      <div class="flex gap-6 shrink-0">
        {breaking.map((article, i) => (
          <a href={article.slug} class="shrink-0 whitespace-nowrap text-sm font-medium hover:text-enjoy-orange transition-colors" aria-label={`Urgente: ${article.data.title}`}>
            {article.data.kicker ? <span class="text-enjoy-brownLight mr-2">[{article.data.kicker}]</span> : null}
            {article.data.title}
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>