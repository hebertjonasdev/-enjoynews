---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description = 'EnjoyNews - Jornalismo automatizado com curadoria editorial. Notícias do Brasil, mundo e Latino-América resumidas com rigor e elegância.',
  canonical,
  ogImage,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author,
  section,
  tags,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://enjoynews.com.br';
const finalCanonical = canonical || Astro.url.pathname;
const finalOgImage = ogImage || `${siteUrl}/og-default.jpg`;

const metaTags = [
  { name: 'viewport', content: 'width=device-width, initial-scale=1' },
  { name: 'description', content: description },
  { name: 'theme-color', content: '#E86C00' },
  { property: 'og:site_name', content: 'EnjoyNews' },
  { property: 'og:type', content: ogType },
  { property: 'og:url', content: `${siteUrl}${finalCanonical}` },
  { property: 'og:title', content: title },
  { property: 'og:description', content: description },
  { property: 'og:image', content: finalOgImage },
  { name: 'twitter:card', content: 'summary_large_image' },
  { name: 'twitter:site', content: '@enjoynews' },
  { name: 'twitter:title', content: title },
  { name: 'twitter:description', content: description },
  { name: 'twitter:image', content: finalOgImage },
];

if (publishedTime) metaTags.push({ property: 'article:published_time', content: publishedTime });
if (modifiedTime) metaTags.push({ property: 'article:modified_time', content: modifiedTime });
if (author) metaTags.push({ property: 'article:author', content: author });
if (section) metaTags.push({ property: 'article:section', content: section });
if (tags?.length) tags.forEach(tag => metaTags.push({ property: 'article:tag', content: tag }));
if (noindex) metaTags.push({ name: 'robots', content: 'noindex, nofollow' });
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <link rel="canonical" href={`${siteUrl}${finalCanonical}`} />
    <link rel="alternate" type="application/rss+xml" title="EnjoyNews RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap" /></noscript>

    {metaTags.map(tag => (
      tag.name ? <meta name={tag.name} content={tag.content} /> : <meta property={tag.property} content={tag.content} />
    ))}

    <title>{title} | EnjoyNews</title>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ogType === 'article' ? "NewsArticle" : "WebSite",
      "name": "EnjoyNews",
      "url": siteUrl,
      "logo": `${siteUrl}/logo.png`,
      "publisher": {
        "@type": "Organization",
        "name": "EnjoyNews",
        "logo": { "@type": "ImageObject", "url": `${siteUrl}/logo.png` }
      },
      ...(ogType === 'article' && {
        "headline": title,
        "description": description,
        "image": finalOgImage,
        "datePublished": publishedTime,
        "dateModified": modifiedTime || publishedTime,
        "author": { "@type": "Person", "name": author || "EnjoyNews Bot" },
        "articleSection": section,
        "keywords": tags?.join(', '),
        "mainEntityOfPage": { "@type": "WebPage", "@id": `${siteUrl}${finalCanonical}` }
      })
    }, null, 2)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot name="header" />
    <main class="flex-1" id="main-content">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>