---
import Layout from '../components/layout/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout
  title="Contato - EnjoyNews"
  description="Entre em contato com a equipe do EnjoyNews."
>
  <slot name="header">
    <Header />
  </slot>

  <div class="container mx-auto px-4 py-8 lg:py-12 max-w-3xl">
    <header class="mb-12 text-center">
      <h1 class="font-display text-enjoy-ink text-3xl lg:text-4xl mb-4">Contato</h1>
      <p class="text-enjoy-inkLight text-lg">Gostou? Tem sugestão? Encontrou um erro? Fale conosco.</p>
    </header>

    <div class="grid lg:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-enjoy-ink text-xl mb-4">Canais</h2>
        <dl class="space-y-6">
          <div>
            <dt class="font-medium text-enjoy-ink mb-1">E-mail geral</dt>
            <dd><a href="mailto:contato@enjoynews.com.br" class="link">contato@enjoynews.com.br</a></dd>
          </div>
          <div>
            <dt class="font-medium text-enjoy-ink mb-1">Privacidade / LGPD</dt>
            <dd><a href="mailto:privacidade@enjoynews.com.br" class="link">privacidade@enjoynews.com.br</a></dd>
          </div>
          <div>
            <dt class="font-medium text-enjoy-ink mb-1">Reportar erro factual</dt>
            <dd><a href="mailto:correcoes@enjoynews.com.br" class="link">correcoes@enjoynews.com.br</a></dd>
          </div>
          <div>
            <dt class="font-medium text-enjoy-ink mb-1">Parcerias / Imprensa</dt>
            <dd><a href="mailto:parcerias@enjoynews.com.br" class="link">parcerias@enjoynews.com.br</a></dd>
          </div>
        </dl>
      </div>

      <div>
        <h2 class="font-display text-enjoy-ink text-xl mb-4">Formulário</h2>
        <form action="https://formspree.io/f/SEU_ID" method="POST" class="space-y-4" netlify>
          <div>
            <label for="name" class="block text-sm font-medium text-enjoy-ink mb-1">Nome</label>
            <input type="text" id="name" name="name" required class="input" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-enjoy-ink mb-1">E-mail</label>
            <input type="email" id="email" name="email" required class="input" />
          </div>
          <div>
            <label for="subject" class="block text-sm font-medium text-enjoy-ink mb-1">Assunto</label>
            <select id="subject" name="subject" required class="input">
              <option value="">Selecione</option>
              <option value="geral">Dúvida / Sugestão geral</option>
              <option value="erro">Reportar erro factual</option>
              <option value="privacidade">Privacidade / LGPD</option>
              <option value="parceria">Parceria / Imprensa</option>
              <option value="tecnico">Problema técnico</option>
              <option value="outro">Outro</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-enjoy-ink mb-1">Mensagem</label>
            <textarea id="message" name="message" rows="5" required class="input resize-y"></textarea>
          </div>
          <button type="submit" class="btn-primary w-full">Enviar</button>
          <p class="text-xs text-enjoy-inkMuted text-center">
            Ao enviar, você concorda com nossa <a href="/privacidade" class="underline hover:text-enjoy-orange">Política de Privacidade</a>.
          </p>
        </form>
      </div>
    </div>

    <div class="mt-16 p-6 bg-enjoy-beige rounded-xl text-center">
      <h3 class="font-display text-enjoy-ink text-lg mb-2">Prefere abrir uma issue?</h3>
      <p class="text-enjoy-inkLight mb-4">Nosso código é open source. Bugs, sugestões e melhorias podem ser reportados no GitHub.</p>
      <a href="https://github.com/SEU_USUARIO/enjoynews/issues" target="_blank" rel="noopener" class="btn-secondary inline-flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.305-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        Ver Issues no GitHub
      </a>
    </div>
  </div>

  <slot name="footer">
    <Footer />
  </slot>
</Layout>