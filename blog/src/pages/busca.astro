---
import Layout from '../components/layout/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ArticleCard from '../components/article/ArticleCard.astro';
---

<Layout
  title="Busca - EnjoyNews"
  description="Busque notícias no EnjoyNews."
  noindex={true}
>
  <slot name="header">
    <Header />
  </slot>

  <div class="container mx-auto px-4 py-8 lg:py-12">
    <header class="mb-10 max-w-2xl">
      <h1 class="font-display text-enjoy-ink text-3xl lg:text-4xl mb-4">Buscar notícias</h1>
      <form id="search-form" class="flex gap-3" role="search">
        <label for="search-input" class="sr-only">Termo de busca</label>
        <input
          type="search"
          id="search-input"
          name="q"
          placeholder="Digite palavras-chave..."
          class="input flex-1"
          autocomplete="off"
          required
        />
        <button type="submit" class="btn-primary whitespace-nowrap">Buscar</button>
      </form>
    </header>

    <div id="search-results" class="hidden">
      <div id="results-count" class="mb-6 text-enjoy-inkMuted"></div>
      <div id="results-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"></div>
      <div id="no-results" class="hidden text-center py-16">
        <svg class="w-16 h-16 mx-auto text-enjoy-brownLight mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <h2 class="font-display text-enjoy-ink text-xl mb-2">Nenhum resultado encontrado</h2>
        <p class="text-enjoy-inkMuted">Tente termos diferentes ou mais genéricos.</p>
      </div>
    </div>

    <!-- Recent articles fallback -->
    <section id="recent-articles" aria-labelledby="recent-title">
      <h2 id="recent-title" class="font-display text-enjoy-ink text-2xl mb-6">Artigos recentes</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {(
          await Astro.glob('../content/posts/*.mdx')
        )
          .map(post => ({
            ...post,
            data: post.frontmatter,
            slug: `/post/${post.file.split('/').pop()?.replace('.mdx', '')}`,
          }))
          .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
          .slice(0, 9)
          .map((post, i) => (
            <ArticleCard {...post.data} slug={post.slug} key={post.slug} class="stagger-{i + 1} animate-slide-up" />
          ))
        }
      </div>
    </section>
  </div>

  <script>
    // Client-side search using pre-built index
    const searchInput = document.getElementById('search-input');
    const searchForm = document.getElementById('search-form');
    const searchResults = document.getElementById('search-results');
    const resultsCount = document.getElementById('results-count');
    const resultsGrid = document.getElementById('results-grid');
    const noResults = document.getElementById('no-results');
    const recentArticles = document.getElementById('recent-articles');

    let searchIndex: Array<{title: string, description: string, slug: string, category: string, tags: string[], pubDate: string, heroImage: string}> = [];

    async function loadIndex() {
      try {
        const resp = await fetch('/search-index.json');
        searchIndex = await resp.json();
      } catch (e) {
        console.warn('Search index not available');
      }
    }

    function search(query: string) {
      const terms = query.toLowerCase().split(' ').filter(t => t.length > 1);
      return searchIndex
        .map(item => {
          const haystack = `${item.title} ${item.description} ${item.category} ${item.tags.join(' ')}`.toLowerCase();
          let score = 0;
          terms.forEach(term => {
            if (haystack.includes(term)) score += 1;
            if (item.title.toLowerCase().includes(term)) score += 3;
            if (item.tags.some(t => t.toLowerCase().includes(term))) score += 2;
          });
          return { ...item, score };
        })
        .filter(item => item.score > 0)
        .sort((a, b) => b.score - a.score);
    }

    function renderResults(results: any[], query: string) {
      if (results.length === 0) {
        resultsGrid.innerHTML = '';
        noResults.classList.remove('hidden');
        resultsCount.textContent = `Nenhum resultado para "${query}"`;
        return;
      }

      noResults.classList.add('hidden');
      resultsCount.textContent = `${results.length} resultado${results.length !== 1 ? 's' : ''} para "${query}"`;
      resultsGrid.innerHTML = results.slice(0, 12).map((item, i) => `
        <article class="card-interactive animate-slide-up stagger-${i + 1}" style="animation-delay: ${i * 0.05}s">
          ${item.heroImage ? `<img src="${item.heroImage}" alt="" class="w-full h-48 object-cover" loading="lazy" />` : ''}
          <div class="p-4 lg:p-5">
            <div class="flex flex-wrap gap-2 mb-2">
              ${item.category ? `<span class="badge-brown text-sm">${item.category}</span>` : ''}
              ${item.tags.slice(0, 2).map(tag => `<span class="badge-gray text-sm">#${tag}</span>`).join('')}
            </div>
            <h2 class="font-display text-enjoy-ink mb-2 leading-tight">
              <a href="${item.slug}" class="hover:text-enjoy-orange hover:underline">${item.title}</a>
            </h2>
            <p class="text-enjoy-inkLight text-sm line-clamp-3 mb-3">${item.description}</p>
            <div class="flex items-center justify-between pt-3 border-t border-enjoy-line">
              <time class="text-xs text-enjoy-inkMuted">${new Date(item.pubDate).toLocaleDateString('pt-BR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}</time>
            </div>
          </div>
        </article>
      `).join('');
    }

    let debounceTimer: number;
    searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(() => {
        const query = searchInput.value.trim();
        if (query.length < 2) {
          searchResults.classList.add('hidden');
          recentArticles.classList.remove('hidden');
          return;
        }
        const results = search(query);
        renderResults(results, query);
        searchResults.classList.remove('hidden');
        recentArticles.classList.add('hidden');
      }, 150);
    });

    searchForm.addEventListener('submit', e => {
      e.preventDefault();
      const query = searchInput.value.trim();
      if (query.length >= 2) {
        const results = search(query);
        renderResults(results, query);
        searchResults.classList.remove('hidden');
        recentArticles.classList.add('hidden');
      }
    });

    loadIndex();
  </script>

  <slot name="footer">
    <Footer />
  </slot>
</Layout>