---
import Layout from '../../components/layout/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import ArticleCard from '../../components/article/ArticleCard.astro';

export async function getStaticPaths() {
  const posts = await Astro.glob('../content/posts/*.mdx');
  const tags = new Set<string>();
  posts.forEach(post => {
    post.frontmatter.tags?.forEach((tag: string) => tags.add(tag.toLowerCase()));
  });
  return Array.from(tags).map(tag => ({ params: { slug: tag } }));
}

const { slug } = Astro.props;
const tagName = slug;

// Get posts for this tag
const allPosts = await Astro.glob('../content/posts/*.mdx');
const tagPosts = allPosts
  .filter(p => p.frontmatter.tags?.some((t: string) => t.toLowerCase() === tagName))
  .map(post => ({
    ...post,
    data: post.frontmatter,
    slug: `/post/${post.file.split('/').pop()?.replace('.mdx', '')}`,
  }))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<Layout
  title={`#${tagName} - EnjoyNews`}
  description={`Todas as notícias marcadas com #${tagName} no EnjoyNews.`}
>
  <slot name="header">
    <Header />
  </slot>

  <div class="container mx-auto px-4 py-8 lg:py-12">
    <header class="mb-10">
      <nav class="text-sm text-enjoy-inkMuted mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-enjoy-orange">Início</a>
        <span class="mx-2">/</span>
        <span class="font-medium text-enjoy-ink">#{tagName}</span>
      </nav>
      <h1 class="font-display text-enjoy-ink text-3xl lg:text-4xl">#{tagName}</h1>
      <p class="text-enjoy-inkLight mt-2 max-w-2xl">
        {tagPosts.length} notícia{tagPosts.length !== 1 ? 's' : ''} relacionada{tagPosts.length !== 1 ? 's' : ''} a este tema.
      </p>
    </header>

    {tagPosts.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {tagPosts.map((post, i) => (
          <ArticleCard {...post.data} slug={post.slug} class="stagger-{i + 1} animate-slide-up" />
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <svg class="w-16 h-16 mx-auto text-enjoy-brownLight mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <h2 class="font-display text-enjoy-ink text-xl mb-2">Nenhuma notícia com esta tag</h2>
      </div>
    )}
  </div>

  <slot name="footer">
    <Footer />
  </slot>
</Layout>