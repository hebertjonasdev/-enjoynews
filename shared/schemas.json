{
  "RawArticle": {
    "type": "object",
    "properties": {
      "url": { "type": "string", "format": "uri" },
      "title": { "type": "string", "minLength": 1, "maxLength": 500 },
      "source_name": { "type": "string", "minLength": 1 },
      "source_type": { "type": "string", "enum": ["rss", "newsapi", "gnews", "nitter", "sitemap", "manual"] },
      "source_url": { "type": ["string", "null"], "format": "uri" },
      "published_at": { "type": "string", "format": "date-time" },
      "fetched_at": { "type": "string", "format": "date-time" },
      "raw_html": { "type": ["string", "null"] },
      "raw_text": { "type": ["string", "null"] },
      "author": { "type": ["string", "null"] },
      "language": { "type": "string", "default": "pt" },
      "category_hint": { "type": ["string", "null"], "enum": ["Brasil", "Mundo", "Economia", "Tecnologia", "Esportes", "Ciência", "Cultura", "Latino-América", "Saúde", "Meio Ambiente", "Política", "Educação"] },
      "tags": { "type": "array", "items": { "type": "string" } },
      "metadata": { "type": "object" }
    },
    "required": ["url", "title", "source_name", "source_type", "published_at"]
  },
  "Summary": {
    "type": "object",
    "properties": {
      "headline": { "type": "string", "minLength": 1, "maxLength": 120 },
      "kicker": { "type": "string", "minLength": 1, "maxLength": 80 },
      "lead": { "type": "string", "minLength": 1, "maxLength": 300 },
      "body": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 5 },
      "context": { "type": "string", "minLength": 1, "maxLength": 300 },
      "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
      "importance": { "type": "integer", "minimum": 1, "maximum": 5 },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "model_used": { "type": "string", "minLength": 1 }
    },
    "required": ["headline", "kicker", "lead", "body", "context", "importance", "confidence", "model_used"]
  },
  "ProcessedArticle": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "raw": { "$ref": "#/definitions/RawArticle" },
      "summary": { "$ref": "#/definitions/Summary" },
      "hero_image_url": { "type": ["string", "null"], "format": "uri" },
      "hero_image_alt": { "type": ["string", "null"] },
      "hero_image_credit": { "type": ["string", "null"] },
      "clustered_with": { "type": "array", "items": { "type": "string" } },
      "is_primary_in_cluster": { "type": "boolean", "default": true },
      "created_at": { "type": "string", "format": "date-time" }
    },
    "required": ["id", "raw", "summary"]
  },
  "Cluster": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "primary": { "$ref": "#/definitions/ProcessedArticle" },
      "related": { "type": "array", "items": { "$ref": "#/definitions/ProcessedArticle" } },
      "theme": { "type": "string", "minLength": 1, "maxLength": 200 },
      "updated_at": { "type": "string", "format": "date-time" }
    },
    "required": ["id", "primary", "theme"]
  }
}