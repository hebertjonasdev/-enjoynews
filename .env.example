# ==========================================
# EnjoyNews - Environment Variables
# ==========================================
# Copie para .env e preencha: cp .env.example .env
# NUNCA commite .env (está no .gitignore)

# ------------------------------------------------------------------
# LLM Provider (escolha UM)
# ------------------------------------------------------------------
# Opção A: Ollama remoto grátis (ex: https://ollama.xxx / https://llama.xxx)
OLLAMA_HOST=https://ollama.com

# Opção B: Hugging Face Inference API (grátis 30k req/mês)
# HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------
# News APIs (opcionais - free tiers)
# ------------------------------------------------------------------
# NewsAPI.org - 100 req/dia free
NEWSAPI_KEY=

# GNews.io - 100 req/dia free
GNEWS_KEY=

# ------------------------------------------------------------------
# Stock Footage (pelo menos UM obrigatório para vídeo)
# ------------------------------------------------------------------
# Pexels - 200 req/hora, 20k/mês free
PEXELS_KEY=

# Pixabay - 500 req/hora free
PIXABAY_KEY=

# ------------------------------------------------------------------
# YouTube Shorts Upload (OAuth 2.0 offline access)
# ------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Refresh token (gere com: python -m video.src.auth.youtube)
YOUTUBE_REFRESH_TOKEN=

# ------------------------------------------------------------------
# TikTok Upload
# ------------------------------------------------------------------
# TikTok Developers → Create App → Client Key/Secret
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Access token com escopo video.upload
TIKTOK_ACCESS_TOKEN=

# ------------------------------------------------------------------
# Vercel Deploy (GitHub Actions)
# ------------------------------------------------------------------
# vercel.com/account/tokens → Create Token
VERCEL_TOKEN=
# vercel inspect <deploy-url> → orgId/projectId
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ------------------------------------------------------------------
# Nitter Instances (X/Twitter via RSS - múltiplas para fallback)
# ------------------------------------------------------------------
NITTER_INSTANCES=https://nitter.net,https://nitter.1d4.us,https://nitter.kavin.rocks,https://nitter.catsarch.com,https://nitter.privacydev.net

# ------------------------------------------------------------------
# Configurações Gerais
# ------------------------------------------------------------------
# Timezone para logs (default: America/Sao_Paulo)
TZ=America/Sao_Paulo

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Máximo de artigos por coleta (evita explosão)
MAX_ARTICLES_PER_RUN=50

# Minutos de cache para dedup (evita republicar mesmo assunto)
DEDUP_WINDOW_MINUTES=1440