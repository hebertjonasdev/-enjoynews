# ==========================================
# EnjoyNews - Environment Variables
# ==========================================
# Copie para .env e preencha: cp .env.example .env
# NUNCA commite .env (está no .gitignore)

# ------------------------------------------------------------------
# LLM Providers (prioridade: Groq > Together > HF > Ollama)
# ------------------------------------------------------------------
# Groq Cloud - MELHOR opção grátis: Llama 3.1 70B/8B, Mixtral
# console.groq.com → API Keys (14k req/dia, 30 RPM, 6000 TPM, GRÁTIS)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Together AI - $1 crédito grátis (~10M tokens)
# api.together.xyz → API Keys
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

# Hugging Face Inference API (grátis 30k req/mês)
# hf.co/settings/tokens
HF_API_TOKEN=
HF_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Ollama remoto/local (fallback)
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=llama3.1:8b

# ------------------------------------------------------------------
# News APIs (opcionais - free tiers) - prioridade ordem
# ------------------------------------------------------------------
# NewsAPI.org - 100 req/dia free
NEWSAPI_KEY=

# GNews.io - 100 req/dia free
GNEWS_KEY=

# Currents API - 100 req/dia free
CURRENTS_KEY=

# World News API - 100 req/dia free
WORLDNEWS_KEY=

# The Guardian API - 500 req/dia free (UK/Global)
GUARDIAN_KEY=

# MediaStack - 100 req/mês free (backup apenas)
MEDIASTACK_KEY=

# ------------------------------------------------------------------
# Enrichment APIs (contexto automático nos artigos)
# ------------------------------------------------------------------
# Brasil API - grátis, sem key (CNPJ, CEP, bancos, feriados, IBGE)
BRASIL_API_KEY=

# World Bank API - grátis, sem key básica (indicadores macro)
WORLDBANK_KEY=

# Alpha Vantage - 25 req/dia free (ações/forex)
ALPHAVANTAGE_KEY=

# CoinGecko - grátis generoso (crypto)
COINGECKO_KEY=

# OpenWeatherMap - 1000 req/dia free (clima)
OPENWEATHER_KEY=

# REST Countries - grátis, sem key (metadados países)
RESTCOUNTRIES_KEY=

# ------------------------------------------------------------------
# Stock Footage (pelo menos UM obrigatório para vídeo)
# ------------------------------------------------------------------
# Pexels - 200 req/hora, 20k/mês free
PEXELS_KEY=

# Pixabay - 500 req/hora free
PIXABAY_KEY=

# ------------------------------------------------------------------
# YouTube Shorts Upload (OAuth 2.0 offline access)
# ------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Refresh token (gere com: python -m video.src.upload youtube-auth)
YOUTUBE_REFRESH_TOKEN=

# ------------------------------------------------------------------
# TikTok Upload
# ------------------------------------------------------------------
# TikTok Developers → Create App → Client Key/Secret
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Access token com escopo video.upload
TIKTOK_ACCESS_TOKEN=

# ------------------------------------------------------------------
# Vercel Deploy (GitHub Actions)
# ------------------------------------------------------------------
# vercel.com/account/tokens → Create Token
VERCEL_TOKEN=
# vercel inspect <deploy-url> → orgId/projectId
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ------------------------------------------------------------------
# Nitter Instances (X/Twitter via RSS - múltiplas para fallback)
# ------------------------------------------------------------------
NITTER_INSTANCES=https://nitter.net,https://nitter.1d4.us,https://nitter.kavin.rocks,https://nitter.catsarch.com,https://nitter.privacydev.net

# ------------------------------------------------------------------
# Configurações Gerais
# ------------------------------------------------------------------
# Timezone para logs (default: America/Sao_Paulo)
TZ=America/Sao_Paulo

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Máximo de artigos por coleta (evita explosão)
MAX_ARTICLES_PER_RUN=50

# Minutos de cache para dedup (evita republicar mesmo assunto)
DEDUP_WINDOW_MINUTES=1440